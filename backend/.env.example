# Backend Environment Variables (Kitty)
# PostgreSQL Database connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Flask & Server Config
PORT=7861
HOST=0.0.0.0
FLASK_ENV=development
SECRET_KEY=dev-secret-change-in-production

# CORS & Frontend URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Currency & Formatting
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹

# Optional: Limits & Rate Limiting
MAX_AMOUNT_MINOR=1000000000
RATELIMIT_STORAGE_URI=memory://

# ─── OTP / SMS delivery ─────────────────────────────────────────────
# 6-digit phone-OTP sign-in. Delivery order: MSG91 → Twilio → demo mode.
#
# MSG91 (India; requires a DLT-approved sender + template in production)
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_SENDER_ID=KITTY1
# MSG91_ROUTE=4
#
# Twilio (global)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+15551234567
#
# Demo mode — code is logged server-side and returned in the API response
# as `dev_otp`. NEVER enable with real users unless you accept that trade-off.
# OTP_DEMO_MODE=false
#
# Tuning (defaults shown)
# OTP_TTL_SECONDS=300
# OTP_RESEND_COOLDOWN_SECONDS=30
